# Copie os NOMES abaixo para os Secrets do Lovable Cloud. Nunca faça commit dos valores.

# Supabase (o Lovable Cloud já preenche estes)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site (usado nos links de retorno e no webhook). Ex.: https://cancaoparati.com.br
SITE_URL=

# Letra (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Música (ElevenLabs — a API de música exige plano pago)
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v1

# Pagamento (Mercado Pago — use as credenciais de TESTE primeiro)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=CANCAOPARATI

# Limites de custo
LIMITE_PREVIAS_POR_PESSOA=3
LIMITE_PREVIAS_POR_DIA=100

# E-mail de entrega (opcional, Resend)
RESEND_API_KEY=
EMAIL_FROM="Canção Para Ti <musica@seudominio.com.br>"

# Meta Conversions API (opcional). O ID do Pixel fica em src/lib/site.ts (metaPixelId)
META_PIXEL_ID=
META_CAPI_TOKEN=
